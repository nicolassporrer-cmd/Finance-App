# REQUIRED. SEC fair-access policy: automated traffic must identify itself.
# Format: "AppName contact@email". Without it every www.sec.gov call returns 403
# on the first request — this is not rate limiting.
SEC_USER_AGENT=Finance-App you@example.com

# OPTIONAL. Analyst ratings. Free tier at https://finnhub.io
# Free tier covers recommendation counts but NOT price targets (those 403).
FINNHUB_API_KEY=
